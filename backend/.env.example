# SST Backend Environment Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Configuration for Phase 3 Remediation Engine (Supports OpenRouter or Groq)
OPENROUTER_API_KEY=
# GROQ_API_KEY=
DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
LLAMA_MODEL=deepseek/deepseek-v4.1-flash

# Supabase (SUPABASE_SERVICE_ROLE_KEY bypasses RLS; never expose it to the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=

# Vault (exactly 64 hex characters = 32 bytes). Generate: python -c "import secrets; print(secrets.token_hex(32))"
KEY_VAULT_MASTER_KEY=

# Attestation chain signing key (any random string; keep it secret)
ATTESTATION_HMAC_KEY=

# Optional: proxy IPs/CIDRs allowed to set X-Forwarded-For (Render uses 10.0.0.0/8)
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# Benchmark controls
BENCHMARK_MAX_RUNS_PER_USER_PER_DAY=20
# Optional cost estimate inputs (USD per million tokens). Default 0 disables the estimate.
# BENCHMARK_INPUT_PRICE_PER_MILLION_USD=0.0
# BENCHMARK_OUTPUT_PRICE_PER_MILLION_USD=0.0
